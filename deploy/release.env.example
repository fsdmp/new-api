# 线上发布配置（make 级别的变量赋值，等号两边不要加空格）
# 复制为 deploy/release.env 后填写；deploy/release.env 已被 .gitignore 忽略。
# 注意：不要写行内注释（# 只能整行使用），值里不要带 # 号。

# 目标服务器（root 或对 REMOTE_DIR 有写权限的用户）
SERVER=root@203.0.113.10

# 网关部署目录 = 进程工作目录（存放二进制 / .env / output.log / sandbox/）
REMOTE_DIR=/opt/new-api

# 线上二进制名（与本地构建名 fsdm-new-api 解耦，发布时自动改名上传）
REMOTE_BIN=fsdm-new-api

# 启动参数（原样传给二进制，可留空）
REMOTE_START_ARGS=

# 服务本机监听端口与健康检查路径
HEALTH_PORT=3000
HEALTH_PATH=/api/status

# 发布目标架构（amd64 / arm64）
RELEASE_ARCH=amd64
